{
  "name": "matthew-clark-portfolio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "test:browser": "playwright test",
    "test:browser:install": "playwright install chromium",
    "verify": "npm run lint && npm test && npm run test:browser",
    "lint": "npm run check:dependency-compat && eslint .",
    "check:dependency-compat": "node --test tests/dependency-compat.test.mjs"
  },
  "dependencies": {
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@next/eslint-plugin-next": {
      "fast-glob": "npm:tinyglobby@0.2.17"
    },
    "next": {
      "postcss": "8.5.23"
    }
  },
  "type": "module"
}
